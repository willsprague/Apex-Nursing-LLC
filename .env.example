# Copy this file to .env.local for local development, and add the same two
# values in Vercel under Project Settings > Environment Variables.
# Never commit real values. Never add a NEXT_PUBLIC_ prefix to these.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For staff sign-in (/login and /admin). These two are safe to be public (NEXT_PUBLIC_ is fine here).
# The Supabase integration in Vercel usually adds them for you.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
